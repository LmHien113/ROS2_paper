<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>carrierbot_guidance_test</name>
  <version>0.0.1</version>
  <description>
    Khu thử nghiệm Guidance (LOS + PID) tách biệt với các package gốc.
    Chứa bản sao của fablab_guidance_node (guidance_test_node), launch chạy xe thật
    không dùng MQTT/AMCL/lidar/SLAM, và các script hỗ trợ.
  </description>
  <maintainer email="lmhien.bk@gmail.com">LmHien113</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>carrierbot_msgs</depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>bno055</exec_depend>
  <!-- Chỉ dùng lại (không sửa) các package gốc -->
  <exec_depend>carrierbot_firmware</exec_depend>
  <exec_depend>carrierbot_controller</exec_depend>
  <exec_depend>carrierbot_slam</exec_depend>
  <exec_depend>carrierbot_description</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>xacro</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
